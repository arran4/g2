--- /dev/null
+++ b/.github/workflows/repair-cache.yml
@@ -0,0 +1,60 @@
+name: Repair Cache
+
+permissions:
+  contents: write
+  pull-requests: write
+
+on:
+  workflow_dispatch:
+
+jobs:
+  repair:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Install g2
+        uses: arran4/g2-action@v1.2
+
+      - name: Run g2 cache reconcile
+        run: g2 cache reconcile --repo .
+
+      - name: Verify Cache
+        run: g2 cache verify --repo .
+
+      - name: Check for Cache changes
+        id: changes
+        shell: bash
+        run: |
+          set -euo pipefail
+          git add metadata/md5-cache/ || true
+          if git diff --staged --quiet; then
+            echo "changed=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "changed=true" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Build PR body
+        if: steps.changes.outputs.changed == 'true'
+        shell: bash
+        run: |
+          {
+            echo "Repairs cache consistency drift using \`g2 cache reconcile .\`."
+            echo
+            echo "This synchronizes missing canonical metadata/md5-cache entries, removes stale ones, and corrects mismatches."
+          } > /tmp/pr-body.md
+
+      - name: Create pull request
+        if: steps.changes.outputs.changed == 'true'
+        uses: peter-evans/create-pull-request@v6
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+          commit-message: "chore: repair cache consistency"
+          title: "chore: repair cache consistency"
+          body-path: /tmp/pr-body.md
+          branch: "chore/repair-cache"
+          delete-branch: true
+          base: main
